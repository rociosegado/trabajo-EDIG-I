// ============ INICIO DE MI PARTE: funciones (SELECCION y AVISO) ============

void ledVerde()                            // pone el LED RGB en verde (mismo estilo que ledRojo/ledAmarillo de mi companera)
{setLED(0, 255, 0);}                       // rojo 0, verde al maximo, azul 0

void emitirTono(int frec)                  // hace sonar el buzzer a la frecuencia frec (en Hz)
{
  tone(PIN_BUZZER, frec);                  // tone() no bloquea: el sonido sigue mientras el programa hace otras cosas
}

void apagarTono()                          // apaga el buzzer
{
  noTone(PIN_BUZZER);                      // corta el sonido en el pin del buzzer
}

// acciones compartidas por T4 y T6: entrar al estado AVISO
void irAAviso()
{
  ledAmarillo();                           // LED amarillo: se esta avisando que viene un tono
  mostrarLCD("Nivel " + String(nivel) + "/" + String(NIVEL_MAX), ""); // linea 1: "Nivel N/14"; linea 2 vacia
  tInicio = millis();                      // anota el momento de entrada: equivale a timer(5)
  estado = AVISO;                          // cambia el estado actual a AVISO
}

// estado SELECCION: recibe las lecturas que actualizarMaquina() ya hizo en esta vuelta
void estadoSeleccion(bool perilla, int giro)
{
  if (giro != 0)                           // si la perilla giro (+1 o -1)...
  {
    opcion = (opcion == SI) ? NO : SI;     // ...alterna la opcion: si estaba en SI pasa a NO y viceversa
    mostrarOpcion();                       // redibuja el LCD con la opcion marcada
  }

  if (perilla)                             // si se apreto la perilla, se confirma la opcion elegida
  {
    if (opcion == SI)                      // eligio SI
    {
      //SELECCION -> AVISO (T4)
      Serial.println("T4: SELECCION -> AVISO"); // mensaje en el Monitor Serie para seguir el flujo
      nivel = 1;                           // la prueba empieza en el nivel 1
      irAAviso();                          // LED amarillo, LCD "Nivel 1/14", timer(5) y estado = AVISO
    } else                                 // eligio NO
    {
      //SELECCION -> IDLE (T10)
      Serial.println("T10: SELECCION -> IDLE"); // mensaje en el Monitor Serie
      irAIdle();                           // vuelve al estado de reposo con la funcion de mi companera
    }
  }
}

// estado AVISO: espera 5 s y despues hace sonar el tono del nivel
// el boton que se apriete durante el aviso se descarta solo: actualizarMaquina() ya lo leyo y aca no se usa (BOTON=NONE)
void estadoAviso()
{
  if (millis() - tInicio >= T_AVISO)       // pasaron 5 s desde que entre al estado: timer_fin == 1
  {
    //AVISO -> ESPERA_RESPUESTA (T5)
    ledVerde();                            // LED verde: ahora el paciente tiene que responder. Va ANTES del tono porque tone() usa el mismo timer que el PWM del pin 3 (rojo)
    mostrarLCD("Apriete si oye", "");      // le indica al paciente que apriete el boton si escucha el tono
    emitirTono(frecuencia[nivel - 1]);     // suena la frecuencia del nivel actual (nivel 1 = posicion 0, por eso nivel - 1)
    tInicio = millis();                    // reinicia el reloj: equivale a timer(3) para el tiempo de respuesta
    Serial.print("T5: AVISO -> ESPERA_RESPUESTA | nivel "); // mensaje en el Monitor Serie, parte 1
    Serial.print(nivel);                   // numero de nivel
    Serial.print(" | ");                   // separador
    Serial.print(frecuencia[nivel - 1]);   // frecuencia que esta sonando
    Serial.println(" Hz");                 // unidad y salto de linea
    estado = ESPERA_RESPUESTA;             // cambia el estado actual a ESPERA_RESPUESTA
  }
}

// ============ FIN DE MI PARTE ============

void actualizarMaquina()

{
  bool perilla = perillaPresionada();
  bool boton = botonPresionado();
  int  giro = leerGiroPerilla();
  bool timerFin;
  unsigned long tiempopasado; 

  switch (estado) 
  {
    case IDLE:
      //IDLE -> CHECK_RUIDO
      if (perilla) 
      {
        ledAmarillo();
        mostrarLCD("Midiendo ruido", "Silencio...");
        ruido = 0;
        tInicio = millis(); //timer(2)
        estado = CHECK_RUIDO;
      }
      break;

    case CHECK_RUIDO: 
      {
      int lectura = leerRuido();
      if (lectura > ruido) 
      ruido = lectura;

      tiempopasado = millis() - tInicio;
      if (tiempopasado >= T_RUIDO) 
         timerFin = true;
       else 
         timerFin = false;
      if (timerFin) 
      {
        Serial.print("Ruido medido: ");
        Serial.println(ruido);
        if (ruido < UMBRAL) 
        {
          //CHECK_RUIDO -> SELECCION
          ledNaranja();
          opcion = SI;
          mostrarOpcion();
          estado = SELECCION;
        } else 
        {
          //CHECK_RUIDO -> IDLE
          ledRojo();
          mostrarLCD("Mucho ruido", "Pulse p/reintent");
          estado = IDLE;
        }
      }
      break;
      }

    // ============ INICIO DE MIS CASES ============
    case SELECCION:                                        // cuando el estado actual es SELECCION...
      estadoSeleccion(perilla, giro);                      // ...se ejecuta mi funcion con las lecturas de esta vuelta
      break;                                               // sale del switch

    case AVISO:                                            // cuando el estado actual es AVISO...
      estadoAviso();                                       // ...se ejecuta mi funcion
      break;                                               // sale del switch

    // ---- SOLO PARA PROBAR: borrar cuando este el ESPERA_RESPUESTA real de tu companero/a ----
    case ESPERA_RESPUESTA:                                 // cuando el estado actual es ESPERA_RESPUESTA...
      if (boton)                                           // ...si el paciente apreto el boton
      {
        apagarTono();                                      // apaga el tono
        if (nivel < NIVEL_MAX)                             // si todavia quedan niveles
        {
          Serial.println("(prueba) ESPERA_RESPUESTA -> AVISO"); // mensaje en el Monitor Serie
          nivel = nivel + 1;                               // sube al nivel siguiente
          irAAviso();                                      // vuelve a AVISO con el nivel nuevo
        } else                                             // si era el ultimo nivel
        {
          Serial.println("(prueba) ultimo nivel -> IDLE"); // mensaje en el Monitor Serie
          irAIdle();                                       // termina y vuelve a IDLE (provisorio)
        }
      } else if (millis() - tInicio >= T_RESPUESTA)        // si no apreto y pasaron 3 s
      {
        apagarTono();                                      // apaga el tono
        Serial.println("(prueba) sin respuesta -> IDLE");  // mensaje en el Monitor Serie
        irAIdle();                                         // termina y vuelve a IDLE (provisorio)
      }
      break;                                               // sale del switch
    // ============ FIN DE MIS CASES ============
  } 
}

void setup() 
{
  configurarPines();
  Serial.begin(9600);
  lcd.init();
  lcd.backlight();
  irAIdle();            
}

void loop() 
{
  actualizarMaquina();
}
